---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;

// Always render "other" last, regardless of alphabetical order.
const orderedCategories = [...categories].sort((a, b) => {
  if (a === "other") return 1;
  if (b === "other") return -1;
  return a.localeCompare(b);
});
---

<div
  class="filter-row flex gap-2 overflow-x-auto whitespace-nowrap pb-2 lg:flex-row lg:flex-wrap lg:items-start lg:overflow-visible lg:whitespace-normal lg:pb-0"
  id="category-filters"
>
  <button
    class="category-btn filter-chip" aria-pressed="true"
    data-category="all"
  >
    All
  </button>
  {orderedCategories.map((cat) => (
    <button
      class="category-btn filter-chip" aria-pressed="false"
      data-category={cat}
    >
      {cat}
    </button>
  ))}
</div>
