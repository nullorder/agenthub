---
import { avatarHtml, esc, loadoutButtonHtml } from "../../lib/card";

interface Props {
  name: string;
  authorUsername?: string;
  authorDisplay: string;
  authorUrl: string;
  version?: string;
  license?: string;
  category: string;
  categoryColor: string;
  viewCount: number;
}

const {
  name,
  authorUsername,
  authorDisplay,
  authorUrl,
  version,
  license,
  category,
  categoryColor,
  viewCount,
} = Astro.props;

const displayedViews = viewCount + 1;
const viewsText = new Intl.NumberFormat("en", {
  notation: "compact",
  maximumFractionDigits: 1,
}).format(displayedViews);
const viewsTitle = `${displayedViews.toLocaleString()} ${
  displayedViews === 1 ? "view" : "views"
} (includes this visit)`;
---

<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <h1 class="font-pixel text-[28px] leading-tight text-ink [overflow-wrap:break-word] sm:text-[42px]" set:html={esc(name).replace(/-/g, "-<wbr>")} />
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-ink-2">
      {authorUsername ? (
        <a href={`/authors/${authorUsername}`} class="flex items-center gap-2">
          <Fragment set:html={avatarHtml(authorUsername, 24, { sharp: false })} />
          <span class="author-name">{authorDisplay}</span>
        </a>
      ) : authorUrl ? (
        <a href={authorUrl} target="_blank" rel="noopener noreferrer" class="author-name">{authorDisplay}</a>
      ) : (
        <span class="text-ink">{authorDisplay}</span>
      )}
      {version && (
        <>
          <span class="text-ink-3">•</span>
          <span class="rounded bg-panel-2 px-2 py-0.5 font-mono text-xs text-ink-2">
            v{version}
          </span>
        </>
      )}
      {license && (
        <>
          <span class="text-ink-3">•</span>
          <span class="license-badge rounded px-2 py-0.5 text-xs font-medium">
            {license}
          </span>
        </>
      )}
      <span class="text-ink-3">•</span>
      <span
        class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${categoryColor}`}
      >
        {category}
      </span>
    </div>
  </div>
  <div class="flex shrink-0 items-center gap-2">
  <Fragment set:html={loadoutButtonHtml(name, "!py-1 !text-sm")} />
  <span
    class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line bg-panel px-3 py-1 text-sm font-medium text-ink-2"
    title={viewsTitle}
    aria-label={viewsTitle}
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <span class="font-mono">{viewsText}</span>
  </span>
  </div>
</header>
