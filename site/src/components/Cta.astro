---
---

<section class="hud-panel mt-16 p-8 text-center">
  <p class="hud-label mb-3">Open channel</p>
  <h2 class="font-pixel mb-3 text-[28px] leading-tight text-ink">Missing a plugin?</h2>
  <p class="mb-6 text-base text-ink-2">Build it and list it here, or ask the community.</p>

  <div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
    <a
      href="/submit"
      class="hud-frame rounded-lg border border-line bg-panel p-4 text-left transition-colors hover:border-line-strong hover:bg-panel-2"
    >
      <p class="mb-1 font-semibold text-ink">Add your plugin →</p>
      <p class="text-base leading-relaxed text-ink-2">
        Fill in a short form. We write the JSON and open GitHub with the file ready for your pull request.
      </p>
    </a>

    <a
      href="https://discord.gg/AJMEeFXxXy"
      target="_blank"
      rel="noopener noreferrer"
      class="hud-frame rounded-lg border border-line bg-panel p-4 text-left transition-colors hover:border-line-strong hover:bg-panel-2"
    >
      <p class="mb-1 font-semibold text-ink">Request on Discord →</p>
      <p class="text-base leading-relaxed text-ink-2">
        Ask the community to add it, or suggest a plugin idea you'd like to see.
      </p>
    </a>
  </div>
</section>
