---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;

// Only show the canonical plugin component types in the Type filter.
// Free-form tags (languages, frameworks, services) stay in plugin data for
// search but don't pollute the filter UI. "other" is always rendered last.
const CANONICAL_TYPES = [
  "skills",
  "agents",
  "commands",
  "hooks",
  "mcp-servers",
  "lsp-servers",
  "integration",
  "other",
];
const visibleTags = CANONICAL_TYPES.filter((t) => tags.includes(t));
---

<div
  class="filter-row mb-4 flex gap-2 overflow-x-auto whitespace-nowrap pb-2 lg:mb-0 lg:flex-row lg:flex-wrap lg:items-start lg:overflow-visible lg:whitespace-normal lg:pb-0"
  id="tag-filters"
>
  <button
    class="tag-btn filter-chip" aria-pressed="true"
    data-tag="all"
  >
    All
  </button>
  {visibleTags.map((tag) => (
    <button
      class="tag-btn filter-chip" aria-pressed="false"
      data-tag={tag}
    >
      {tag}
    </button>
  ))}
</div>
