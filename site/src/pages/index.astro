---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Header from "../components/Header.astro";
import SearchBar from "../components/SearchBar.astro";
import Sidebar from "../components/Sidebar.astro";
import PluginCard from "../components/PluginCard.astro";
import Pulse from "../components/Pulse.astro";
import Cta from "../components/Cta.astro";
// import Collaborators from "../components/Collaborators.astro";
import Footer from "../components/Footer.astro";
import { loadPlugins } from "../lib/plugins";

const plugins = loadPlugins();

const categories = [
  ...new Set(plugins.map((p: any) => p.category)),
].sort() as string[];
const allTags = [
  ...new Set(plugins.flatMap((p: any) => p.tags || [])),
].sort() as string[];
const authorCount = [...new Set(plugins.map((p: any) => p.author.username))]
  .length;

const PAGE_SIZE = 24;
const initialPlugins = plugins.slice(0, PAGE_SIZE);
const monthAgo = new Date(Date.now() - 30 * 86400 * 1000).toISOString();
const newCount = plugins.filter((p) => p.addedAt && p.addedAt >= monthAgo).length;
const sorts = [
  { key: "popular", label: "Popular" },
  { key: "new", label: "New" },
  { key: "updated", label: "Updated" },
  { key: "az", label: "A–Z" },
];

const siteUrl = new URL("/", Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "AgentHub",
      url: siteUrl,
      description: "A community-driven marketplace for Claude Code plugins.",
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteUrl.replace(/\/$/, "")}/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "CollectionPage",
      name: "Claude Code Plugins",
      url: siteUrl,
      description: `Browse ${plugins.length} community-built Claude Code plugins from ${authorCount} authors.`,
    },
  ],
};
---

<Layout title="AgentHub — Claude Code Plugin Marketplace" jsonLd={jsonLd}>
  <Navbar />

  <div class="mx-auto w-full max-w-[1600px] flex-1 px-4 py-10 lg:px-8">
    <Header pluginCount={plugins.length} authorCount={authorCount} newCount={newCount} />
    <Pulse />

    <section id="catalog" class="scroll-mt-20" aria-labelledby="catalog-title">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="catalog-title" class="hud-label">Catalog · <span id="result-count">{plugins.length}</span></h2>
        <div class="flex items-center gap-1" role="group" aria-label="Sort plugins">
          {sorts.map((s) => (
            <button type="button" class="sort-btn" data-sort={s.key} aria-pressed={s.key === "popular" ? "true" : "false"}>{s.label}</button>
          ))}
        </div>
      </div>
      <SearchBar />

      <div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">
        <Sidebar categories={categories} tags={allTags} />

        <main>
          <!-- First page is server-rendered; the rest comes from /plugins.json. -->
          <div
            class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
            id="plugin-grid"
            data-total={plugins.length}
          >
            {initialPlugins.map((plugin) => <PluginCard {...plugin} />)}
          </div>
          <script
            type="application/json"
            id="plugins-data"
            set:html={JSON.stringify(initialPlugins)}
          />

          <div id="no-results" class="py-16 text-center" hidden>
            <p class="font-pixel text-[21px] text-ink">NO SIGNAL</p>
            <p class="mt-3 text-ink-2">No plugins match that. Can't find what you need? <a href="/submit" class="text-cyan hover:underline">Build it and add it here</a>.</p>
          </div>

          <div class="mt-8 flex justify-center">
            <button id="load-more" type="button" class="loadout-toggle !px-5 !py-2 !text-sm">
              Load more · <span data-left>{plugins.length - initialPlugins.length}</span> left
            </button>
          </div>
        </main>
      </div>
    </section>

    <Cta />
  </div>

  <Footer />
</Layout>

<script>
  import "../scripts/catalog";
</script>
